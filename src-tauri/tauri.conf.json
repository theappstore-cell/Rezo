{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rezo",
  "mainBinaryName": "Rezo",
  "version": "0.5.0",
  "identifier": "app.rezo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Multi-room audio streaming",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "installerHooks": "installer/hooks.nsh",
        "languages": [
          "French",
          "English"
        ]
      }
    },
    "longDescription": "Streams the audio of this computer to Sonos, UPnP/DLNA speakers, native receivers and web browsers at the same time.",
    "category": "Music",
    "copyright": "theappstore-cell, GPL-3.0",
    "publisher": "theappstore-cell",
    "homepage": "https://github.com/theappstore-cell/Rezo",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
